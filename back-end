// npm init -> cria o pacote inicial API
// npm i express
const express = require("express")
const app = express()
app.use(express.json())
const port = 3000
// npm i mysql2
const db = require("./db")

app.get("/aula", async (req, res) => {
    try {
        const resultado = await db.pool.query("SELECT * FROM aula")
        res.status(200).json(resultado[0])
    } catch (erro) {
        res.status(500).json({ erro: erro.message })
    }
})

app.post("/aula", async (req, res) => {
    try {
        const dados = req.body
        const resultado = await db.pool.query(
            "INSERT INTO aula (serie, turma, componente, professor) VALUES (?, ?, ?, ?)",
            [dados.serie, dados.turma, dados.componente, dados.professor]
        )
        res.status(201).json(
            { resultado: "Aula cadastrada, ID = " + resultado[0].insertId }
        )
    } catch (erro) {
        res.status(500).json({ erro: erro.message })
    }
})

app.delete("/aula/:id", async (req, res) => {
    try {
        const { id } = req.params
        const resultado = await db.pool.query(
            "DELETE FROM aula WHERE id = ?",
            [id]
        )

        if (resultado[0].affectedRows === 0) {
            return res.status(404).json({ erro: "Aula não encontrada." })
        }

        res.status(200).json({ resultado: "Aula removida com sucesso!" })
    } catch (erro) {
        // Caso existam horários vinculados a essa aula (chave estrangeira)
        if (erro.errno === 1451 || erro.code === "ER_ROW_IS_REFERENCED_2") {
            return res.status(400).json({
                erro: "Não é possível excluir esta aula pois existem horários vinculados a ela."
            })
        }
        res.status(500).json({ erro: erro.message })
    }
})

app.post("/horario", async (req, res) => {
    try {
        const dados = req.body
        // Ajuste os nomes das colunas (dia, hora_inicio, hora_fim, id_aula) conforme o seu banco
        const resultado = await db.pool.query(
            "INSERT INTO horario (dia, hora_inicio, hora_fim, id_aula) VALUES (?, ?, ?, ?)",
            [dados.dia, dados.hora_inicio, dados.hora_fim, dados.id_aula]
        )

        res.status(201).json({
            resultado: "Horário cadastrado, ID = " + resultado[0].insertId
        })
    } catch (erro) {
        // Erro 1452 do MySQL: tentativa de inserir uma chave estrangeira (id_aula) inexistente
        if (erro.errno === 1452 || erro.code === "ER_NO_REFERENCED_ROW_2") {
            return res.status(400).json({
                erro: "Erro de chave estrangeira: a aula informada não existe na tabela 'aula'."
            })
        }
        res.status(500).json({ erro: erro.message })
    }
})

app.get("/horario/:dia", async (req, res) => {
    try {
        const { dia } = req.params
        // Faz o JOIN para trazer também os dados da aula associada ao horário
        const resultado = await db.pool.query(
            `SELECT horario.*, aula.serie, aula.turma, aula.componente, aula.professor 
             FROM horario 
             INNER JOIN aula ON horario.id_aula = aula.id 
             WHERE horario.dia = ?`,
            [dia]
        )

        res.status(200).json(resultado[0])
    } catch (erro) {
        res.status(500).json({ erro: erro.message })
    }
})

app.delete("/horario/:id", async (req, res) => {
    try {
        const { id } = req.params
        const resultado = await db.pool.query(
            "DELETE FROM horario WHERE id = ?",
            [id]
        )

        if (resultado[0].affectedRows === 0) {
            return res.status(404).json({ erro: "Horário não encontrado." })
        }

        res.status(200).json({ resultado: "Horário removido com sucesso!" })
    } catch (erro) {
        res.status(500).json({ erro: erro.message })
    }
})

app.listen(port, () => {
    console.log("API rodando na porta " + port)
})
